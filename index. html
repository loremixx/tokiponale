<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toki Pona Learning</title>
    
    <script src="https://unpkg.com/react@18/umd/react.development.js"></script>
    <script src="https://unpkg.com/react-dom@18/umd/react-dom.development.js"></script>
    <script src="https://unpkg.com/@babel/standalone/babel.min.js"></script>
    <script src="https://cdn.tailwindcss.com"></script>
    
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;700;900&display=swap');
        body { font-family: 'Nunito', sans-serif; background-color: #f8fafc; }
        .animate-in { animation: fadeIn 0.3s ease-out forwards; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    </style>
</head>
<body>
    <div id="root"></div>

    <script type="text/babel">
        const { useState, useEffect } = React;

        // --- CURRICULUM DATA ---
        const CURRICULUM = [
            {
                id: 1,
                title: "Unit 1: The Basics",
                description: "Saying hello & simple feelings.",
                color: "bg-green-500",
                exercises: [
                    {
                        id: '1-1', type: 'vocab', prompt: 'Which of these means "Good"?',
                        options: [ { text: 'ike', image: '👎' }, { text: 'pona', image: '👍' }, { text: 'suli', image: '🐘' }, { text: 'lili', image: '🐜' } ],
                        correctAnswer: 'pona', tip: "'pona' means good, simple, or friendly."
                    },
                    {
                        id: '1-2', type: 'translate_tp_en', prompt: 'Translate this sentence',
                        question: 'toki!', words: ['Hello!', 'Goodbye', 'Food', 'Me'],
                        correctAnswer: ['Hello!'], tip: "'toki' is used for hello, goodbye, and speech."
                    },
                    {
                        id: '1-3', type: 'translate_tp_en', prompt: 'Translate this sentence',
                        question: 'mi pona', words: ['I', 'am', 'good', 'you', 'bad', 'is'],
                        correctAnswer: ['I', 'am', 'good'], tip: "No 'li' is used when the subject is 'mi'."
                    }
                ]
            },
            {
                id: 2,
                title: "Unit 2: Actions",
                description: "Eating, sleeping, and seeing.",
                color: "bg-blue-500",
                exercises: [
                    {
                        id: '2-1', type: 'vocab', prompt: 'Which of these means "To Eat"?',
                        options: [ { text: 'lape', image: '😴' }, { text: 'moku', image: '🍎' }, { text: 'telo', image: '💧' }, { text: 'lukin', image: '👀' } ],
                        correctAnswer: 'moku', tip: "'moku' means to eat, drink, or food."
                    },
                    {
                        id: '2-2', type: 'translate_tp_en', prompt: 'Translate this sentence',
                        question: 'ona li lukin', words: ['He', 'looks', 'sleeps', 'is', 'me', 'good'],
                        correctAnswer: ['He', 'looks'], tip: "We use 'li' because the subject 'ona' is not mi/sina."
                    }
                ]
            }
        ];

        // --- COMPONENTS ---
        const Button = ({ children, onClick, variant = 'primary', disabled = false }) => {
            const variants = {
                primary: "bg-green-500 border-green-700 text-white active:bg-green-600",
                danger: "bg-red-500 border-red-700 text-white active:bg-red-600",
                disabled: "bg-slate-200 border-slate-300 text-slate-400 cursor-not-allowed"
            };
            return (
                <button 
                    onClick={disabled ? undefined : onClick}
                    className={`w-full font-bold uppercase tracking-wider py-4 rounded-2xl border-b-4 active:border-b-0 active:translate-y-1 transition-all ${variants[disabled ? 'disabled' : variant]}`}
                >
                    {children}
                </button>
            );
        };

        const ProgressBar = ({ current, total }) => {
            const progress = Math.min(100, (current / total) * 100);
            return (
                <div className="h-4 w-full bg-slate-200 rounded-full overflow-hidden">
                    <div className="h-full bg-green-500 transition-all duration-500" style={{ width: `${progress}%` }}></div>
                </div>
            );
        };

        const WordBubble = ({ text, onClick, selected, disabled }) => (
            <button
                onClick={onClick} disabled={disabled}
                className={`px-4 py-3 m-1 rounded-xl border-b-4 font-bold text-lg transition-all ${selected ? 'bg-slate-200 border-slate-200 text-slate-200 pointer-events-none' : 'bg-white border-slate-200 text-slate-700 active:border-b-0 active:translate-y-1'}`}
            >
                {text}
            </button>
        );

        // --- MAIN APP ---
        function App() {
            const [screen, setScreen] = useState('path'); 
            const [currentUnitIndex, setCurrentUnitIndex] = useState(0);
            const [currentExerciseIndex, setCurrentExerciseIndex] = useState(0);
            const [hearts, setHearts] = useState(5);
            const [selectedWords, setSelectedWords] = useState([]);
            const [lessonStatus, setLessonStatus] = useState('idle');
            const [shuffledOptions, setShuffledOptions] = useState([]);

            const currentUnit = CURRICULUM[currentUnitIndex];
            const currentExercise = currentUnit?.exercises[currentExerciseIndex];

            useEffect(() => {
                if (screen === 'lesson' && currentExercise) {
                    setSelectedWords([]);
                    setLessonStatus('idle');
                    if (currentExercise.type.includes('translate')) {
                        setShuffledOptions([...currentExercise.words].sort(() => Math.random() - 0.5));
                    }
                }
            }, [currentExerciseIndex, screen]);

            const handleWordClick = (word) => { if (lessonStatus === 'idle') setSelectedWords([...selectedWords, word]); };
            const handleRemoveWord = (idx) => { if (lessonStatus === 'idle') setSelectedWords(selectedWords.filter((_, i) => i !== idx)); };
            
            const checkAnswer = () => {
                let isCorrect = false;
                if (currentExercise.type === 'vocab') isCorrect = selectedWords[0] === currentExercise.correctAnswer;
                else isCorrect = selectedWords.join(' ') === currentExercise.correctAnswer.join(' ');

                if (isCorrect) setLessonStatus('correct');
                else {
                    setLessonStatus('wrong');
                    setHearts(h => Math.max(0, h - 1));
                }
            };

            const next = () => {
                if (currentExerciseIndex < currentUnit.exercises.length - 1) {
                    setCurrentExerciseIndex(p => p + 1);
                    setLessonStatus('idle');
                    setSelectedWords([]);
                } else setScreen('summary');
            };

            // SCREEN: PATH
            if (screen === 'path') return (
                <div className="max-w-md mx-auto min-h-screen bg-white flex flex-col items-center border-x border-slate-100">
                    <div className="w-full p-4 flex justify-between border-b sticky top-0 bg-white z-10">
                        <span className="text-2xl">🦉</span>
                        <div className="flex gap-4 font-bold">
                            <span className="text-red-500">❤️ {hearts}</span>
                            <span className="text-orange-500">🔥 12</span>
                        </div>
                    </div>
                    <div className="p-8 w-full flex flex-col gap-8 items-center">
                        {CURRICULUM.map((unit, idx) => (
                            <div key={unit.id} className="flex flex-col items-center">
                                <button onClick={() => { setCurrentUnitIndex(idx); setCurrentExerciseIndex(0); setScreen('lesson'); }} 
                                    className={`w-20 h-20 rounded-full ${unit.color} border-b-8 border-black/20 flex items-center justify-center text-white text-3xl shadow-xl active:border-b-0 active:translate-y-2`}>
                                    ★
                                </button>
                                <span className="font-bold text-slate-700 mt-2">{unit.title}</span>
                            </div>
                        ))}
                    </div>
                </div>
            );

            // SCREEN: SUMMARY
            if (screen === 'summary') return (
                <div className="min-h-screen bg-yellow-400 flex flex-col items-center justify-center p-6 text-center">
                    <div className="text-8xl mb-4">🏆</div>
                    <h1 className="text-3xl font-extrabold text-yellow-800 mb-8">Unit Complete!</h1>
                    <Button onClick={() => setScreen('path')} variant="primary" className="bg-yellow-600 border-yellow-800">Continue</Button>
                </div>
            );

            // SCREEN: LESSON
            return (
                <div className="max-w-md mx-auto min-h-screen bg-white flex flex-col">
                    <div className="p-4 flex items-center gap-4">
                        <span onClick={() => setScreen('path')} className="text-2xl cursor-pointer">✕</span>
                        <ProgressBar current={currentExerciseIndex} total={currentUnit.exercises.length} />
                        <span className="text-red-500 font-bold">❤️ {hearts}</span>
                    </div>

                    <div className="flex-1 p-4 pb-32 overflow-y-auto">
                        <h2 className="text-2xl font-bold text-slate-700 mb-8">{currentExercise.prompt}</h2>

                        {/* VOCAB TYPE */}
                        {currentExercise.type === 'vocab' && (
                            <div className="grid grid-cols-2 gap-4">
                                {currentExercise.options.map(opt => (
                                    <button key={opt.text} onClick={() => lessonStatus === 'idle' && setSelectedWords([opt.text])}
                                        className={`p-4 rounded-xl border-2 border-b-4 flex flex-col items-center gap-2 ${selectedWords.includes(opt.text) ? 'border-blue-400 bg-blue-50' : 'border-slate-200'}`}>
                                        <span className="text-4xl">{opt.image}</span>
                                        <span className="font-bold text-lg text-slate-700">{opt.text}</span>
                                    </button>
                                ))}
                            </div>
                        )}

                        {/* TRANSLATE TYPE */}
                        {currentExercise.type.includes('translate') && (
                            <div className="flex flex-col gap-6">
                                <div className="flex items-center gap-4">
                                    <div className="p-3 bg-blue-500 rounded-xl text-white">🔊</div>
                                    <p className="text-xl text-slate-600 font-medium">{currentExercise.question}</p>
                                </div>
                                <div className="min-h-[80px] border-t-2 border-b-2 border-slate-100 py-4 flex flex-wrap gap-2">
                                    {selectedWords.map((w, i) => (
                                        <button key={i} onClick={() => handleRemoveWord(i)} className="px-4 py-3 rounded-xl border-b-4 bg-white border-slate-200 text-slate-700 font-bold text-lg">{w}</button>
                                    ))}
                                </div>
                                <div className="flex flex-wrap justify-center">
                                    {shuffledOptions.map((w, i) => (
                                        <WordBubble key={i} text={w} onClick={() => handleWordClick(w)} selected={selectedWords.includes(w) && !shuffledOptions.filter(wd=>wd===w).slice(selectedWords.filter(s=>s===w).length).length} disabled={false} />
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>

                    {/* FOOTER */}
                    <div className={`border-t-2 p-4 pb-8 ${lessonStatus === 'correct' ? 'bg-green-100' : lessonStatus === 'wrong' ? 'bg-red-100' : 'bg-white'}`}>
                        {lessonStatus !== 'idle' && (
                            <div className="mb-4">
                                <h3 className={`font-bold text-xl ${lessonStatus === 'correct' ? 'text-green-700' : 'text-red-700'}`}>
                                    {lessonStatus === 'correct' ? 'Excellent!' : 'Correct solution:'}
                                </h3>
                                {lessonStatus === 'wrong' && <p className="text-red-600 mb-2">{Array.isArray(currentExercise.correctAnswer) ? currentExercise.correctAnswer.join(' ') : currentExercise.correctAnswer}</p>}
                                <div className="text-sm bg-white/50 p-2 rounded text-slate-600"><strong>TIP:</strong> {currentExercise.tip}</div>
                            </div>
                        )}
                        {lessonStatus === 'idle' 
                            ? <Button onClick={checkAnswer} disabled={selectedWords.length === 0}>Check</Button>
                            : <Button onClick={hearts > 0 ? next : () => { setHearts(5); setScreen('path'); }} variant={lessonStatus === 'correct' ? 'primary' : 'danger'}>{hearts > 0 ? 'Continue' : 'Retry'}</Button>
                        }
                    </div>
                </div>
            );
        }

        const root = ReactDOM.createRoot(document.getElementById('root'));
        root.render(<App />);
    </script>
</body>
</html>
 
